# Cecil redirects' pages
{%- for page in site.allPages|filter(p => p.redirect is defined) ~%}
{{ url(page, {'canonical': false}) }}    {{ url(page.redirect, {'canonical': false}) }}    301!
{%- endfor -%}
{%- if site.netlify.redirects|default([])|length > 0 ~%}
# Redirects defined in config
  {%- for redirect in site.netlify.redirects ~%}
{{ url(redirect.from, {'canonical': false}) }}    {{ url(redirect.to, {'canonical': false}) }}{% if redirect.status is defined or redirect.force|default(false) %}    {{ redirect.status|default(301) }}{% if redirect.force|default(false) %}!{% endif %}{% endif ~%}
  {%- endfor ~%}
{%- endif -%}
{%- if site.netlify.redirect_by_language|default(false) and site.languages|length > 1 ~%}
# Languages redirects
  {%- for language in site.languages|filter(l => l.code != site.language) ~%}
/    /{{ language.code }}/    302!    Language={{ language.code }}
  {%- endfor -%}
{%- endif -%}
{%- set pages404 = {} -%}
{%- if (site.netlify.localized_404 ?? true) and site.languages|length > 1 -%}
  {%- for language in site.languages|filter(l => l.code != site.language) -%}
    {%- if site.page('404', language.code) -%}
      {%- set pages404 = pages404|merge({(language.code): site.page('404', language.code)}) -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if pages404|length > 0 ~%}
# Localized 404 error pages
  {%- for code, page404 in pages404 ~%}
/{{ code }}/*    {{ url(page404, {'canonical': false}) }}    404
  {%- endfor -%}
{%- endif ~%}